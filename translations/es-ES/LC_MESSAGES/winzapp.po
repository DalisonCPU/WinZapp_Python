#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/ai_media_demo.py:129
msgctxt "ai_demo_notice"
msgid ""
"Fictional chat; no WhatsApp connection or messages sent. The generated "
"picture contains WINZAPP DEMO 123, a blue rectangle, a red circle and a "
"yellow triangle. Settings and keys are separate from your installed WinZapp."
" Start with Settings, then focus the photo and press Ctrl+Shift+I. Real AI "
"answers require your own API key and may cost money; no simulated answers "
"are supplied."
msgstr ""
"Conversación ficticia; sin conexión a WhatsApp ni envío de mensajes. La "
"imagen generada contiene WINZAPP DEMO 123, un rectángulo azul, un círculo "
"rojo y un triángulo amarillo. Los ajustes y las claves están separados del "
"WinZapp instalado. Abre Ajustes, enfoca la foto y pulsa Ctrl+Shift+I. Las "
"respuestas reales requieren tu propia clave API y pueden tener coste; no hay"
