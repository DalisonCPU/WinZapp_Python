#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1955
#, python-brace-format
msgctxt "wpp_force_reinstall_confirm_msg"
msgid ""
"This will stop WPPConnect (if running), delete the current installation, and"
" download and install the latest version (v{version}), without checking "
"whether it's already the installed one. Continue?"
msgstr ""
"Esto detendrá WPPConnect (si está en ejecución), eliminará la instalación "
"actual y descargará e instalará la versión más reciente (v{version}), sin "
"comprobar si ya es la versión instalada. ¿Continuar?"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1956
msgctxt "wpp_force_reinstall_confirm_title"
msgid "Force reinstall WPPConnect"
msgstr "Forzar reinstalación de WPPConnect"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/settings_dialog.py:3663
#: client/ui/dialogs/settings_dialog.py:866
msgctxt "wpp_port_label"
msgid "API port (WPPConnect):"
msgstr "Puerto de la API (WPPConnect):"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/settings.py:266
msgctxt "wpp_reinstall_notice_message"
msgid ""
"Your current WPPConnect installation may be missing the latest features, "
"such as voice and video calls. Do you want to reinstall WPPConnect now? If "
"you change your mind, you can always access this option from the Help menu "
"(alt+h)."
msgstr ""
"Tu instalación actual de WPPConnect puede no tener todas las funciones más "
"recientes, como las llamadas de voz y video. ¿Deseas reinstalar WPPConnect "
"ahora? Si cambias de opinión, siempre puedes acceder a esta opción en el "
"menú de ayuda (alt+y)."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/settings.py:270
msgctxt "wpp_reinstall_notice_title"
msgid "WPPConnect update recommended"
msgstr "Actualización de WPPConnect recomendada"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1891
#, python-brace-format
msgctxt "wpp_update_available_msg"
msgid ""
"A recommended update for WPPConnect Server is available (current: {current},"
" new: {new}). It is not mandatory. Update now? WinZapp will stop the API, "
"install the new version, and restart it automatically."
msgstr ""
"Hay una actualización recomendada de WPPConnect Server disponible (actual: "
"{current}, nueva: {new}). No es obligatoria. ¿Deseas actualizar ahora? "
"WinZapp detendrá la API, instalará la nueva versión y la reiniciará "
"automáticamente."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1890
msgctxt "wpp_update_available_title"
msgid "WPPConnect update available"
msgstr "Actualización de WPPConnect disponible"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_background_update.py:157
#, python-brace-format
msgctxt "wpp_update_background_ready_msg"
msgid ""
"WPPConnect update {version} has been downloaded. WinZapp will go offline for"
" a moment to install it and restart WPPConnect."
msgstr ""
"Se ha descargado la actualización {version} de WPPConnect. WinZapp quedará "
"sin conexión unos instantes para instalarla y reiniciar WPPConnect."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:171
msgctxt "wpp_update_background_running"
msgid ""
"A WPPConnect update is already downloading in the background. You will be "
"told when it is ready to install."
msgstr ""
"Ya se está descargando una actualización de WPPConnect en segundo plano. Se "
"te avisará cuando esté lista para instalar."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_background_update.py:92
msgctxt "wpp_update_background_started"
msgid ""
"Downloading the WPPConnect update in the background. You will be told when "
"it is ready to install."
msgstr ""
"Descargando la actualización de WPPConnect en segundo plano. Se te avisará "
"cuando esté lista para instalar."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:316
msgctxt "wpp_update_complete"
msgid "WPPConnect updated and restarted successfully."
msgstr "WPPConnect actualizada y reiniciada con éxito."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:276
#: client/main_window/updates.py:279
#: client/main_window/wpp_background_update.py:137
msgctxt "wpp_update_failed_msg"
msgid ""
"Could not update WPPConnect. The previous installation will be kept, if "
"possible."
msgstr ""
"No se pudo actualizar WPPConnect. Se mantendrá la instalación anterior, si "
"es posible."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1943
msgctxt "wpp_update_fetch_failed_msg"
msgid ""
"Could not check the latest WPPConnect version. Check your internet "
"connection and try again."
msgstr ""
"No se pudo comprobar la versión más reciente de WPPConnect. Verifica tu "
"conexión a internet e inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:207
#: client/main_window/updates.py:291
msgctxt "wpp_update_in_progress"
msgid "Updating WPPConnect. Please wait."
msgstr "Actualizando WPPConnect. Espera un momento."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:187
msgctxt "wpp_update_other_account_msg"
msgid ""
"Another WinZapp account is still using the WPPConnect Server. Close the "
"other accounts and try again."
msgstr ""
"Otra cuenta de WinZapp todavía está usando WPPConnect Server. Cierra las "
"demás cuentas e inténtalo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_server.py:1252
msgctxt "wpp_version_unpinned_warning"
msgid ""
"Warning: could not pin the WhatsApp Web version. Sending to individual "
"contacts may fail silently; groups still work. Please update WinZapp's "
"WhatsApp Web."
msgstr ""
"Aviso: no se pudo fijar la versión de WhatsApp Web. El envío a contactos "
"individuales puede fallar en silencio; los grupos siguen funcionando. "
"Actualice el WhatsApp Web de WinZapp."

