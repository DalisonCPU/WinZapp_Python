#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/chat_lists.py:9
msgctxt "wa_lists_runtime_incomplete"
msgid ""
"This version lacks the functions needed to edit lists. You can still view "
"lists."
msgstr ""
"Esta versión no tiene las funciones necesarias para editar listas. Puedes "
"seguir viendo las listas."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/chat_lists.py:32
msgctxt "wa_lists_scope"
msgid ""
"You can add chats shown here to your lists or remove them. Locked chats "
"cannot be selected. Other chats stay in the list."
msgstr ""
"Puedes añadir a tus listas los chats que aparecen aquí o quitarlos. Los "
"chats bloqueados no se pueden seleccionar. Los demás chats permanecen en la "
"lista."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/chat_lists.py:189
msgctxt "wa_lists_selection_changed"
msgid ""
"This selection could not be applied. Refresh the lists and select again; "
"choose fewer chats if needed."
msgstr ""
"No se pudo aplicar esta selección. Actualiza las listas y vuelve a "
"seleccionar; elige menos chats si es necesario."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/chat_lists.py:22
msgctxt "wa_lists_unavailable"
msgid "WhatsApp lists are unavailable in this version."
msgstr "Las listas de WhatsApp no están disponibles en esta versión."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/chat_lists.py:20
msgctxt "wa_lists_unconfirmed"
msgid ""
"The change could not be verified. Refresh the lists before trying again; it "
"may already have been applied."
msgstr ""
"No se pudo confirmar el cambio. Actualiza las listas antes de volver a "
"intentarlo; puede que ya se haya aplicado."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main.py:1165
#: client/ui/dialogs/connect.py:1031
msgctxt "websocket_failed_reconnect"
msgid ""
"The WebSocket connection failed. This can happen when a previous pairing attempt was not completed.\n"
"\n"
"You will be redirected to the connection dialog to try again."
msgstr ""
"La conexión WebSocket falló. Esto puede ocurrir cuando un intento de emparejamiento anterior no se completó.\n"
"\n"
"Serás redirigido al diálogo de conexión para intentarlo de nuevo."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/dialogs/connect.py:1244
