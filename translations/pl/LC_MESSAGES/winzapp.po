"Możesz dodawać do list widoczne tutaj czaty lub je usuwać. Zablokowanych "
"czatów nie można wybrać. Pozostałe czaty zostają na liście."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/chat_lists.py:189
msgctxt "wa_lists_selection_changed"
msgid ""
"This selection could not be applied. Refresh the lists and select again; "
"choose fewer chats if needed."
msgstr ""
"Nie udało się zastosować tego wyboru. Odśwież listy i wybierz ponownie; w "
"razie potrzeby wybierz mniej czatów."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/chat_lists.py:22
msgctxt "wa_lists_unavailable"
msgid "WhatsApp lists are unavailable in this version."
msgstr "Listy WhatsApp nie są dostępne w tej wersji."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/chat_lists.py:20
msgctxt "wa_lists_unconfirmed"
msgid ""
"The change could not be verified. Refresh the lists before trying again; it "
"may already have been applied."
msgstr ""
"Nie udało się potwierdzić zmiany. Odśwież listy przed ponowną próbą; zmiana "
"mogła już zostać zastosowana."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main.py:1165
#: client/ui/dialogs/connect.py:1031
msgctxt "websocket_failed_reconnect"
msgid ""
"The WebSocket connection failed. This can happen when a previous pairing attempt was not completed.\n"
"\n"
"You will be redirected to the connection dialog to try again."
msgstr ""
"Połączenie WebSocket nie powiodło się. Może się to zdarzyć, gdy poprzednia próba parowania nie została ukończona.\n"
"\n"
"Zostaniesz przekierowany do okna połączenia, aby spróbować ponownie."

#: translations/en-US/LC_MESSAGES/winzapp.po client/ui/dialogs/connect.py:1244
msgctxt "websocket_init_failed"
msgid "An error occurred while connecting to the WebSocket:"
msgstr "Wystąpił błąd podczas łączenia z WebSocket:"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1117
msgctxt "whats_new_btn"
msgid "&What's new?"
msgstr "&Co nowego?"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:839
msgctxt "whats_new_close"
msgid "&Close"
msgstr "&Zamknij"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/window_chrome.py:883
msgctxt "whats_new_none_message"
msgid "No changelog is available for this version."
msgstr "Brak dziennika zmian dla tej wersji."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/window_chrome.py:884
msgctxt "whats_new_none_title"
msgid "No news"
msgstr "Brak nowości"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:821
msgctxt "whats_new_title"
msgid "What's new in WinZapp"
msgstr "Co nowego w WinZapp"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1955
#, python-brace-format
msgctxt "wpp_force_reinstall_confirm_msg"
msgid ""
"This will stop WPPConnect (if running), delete the current installation, and"
" download and install the latest version (v{version}), without checking "
"whether it's already the installed one. Continue?"
msgstr ""
"Spowoduje to zatrzymanie WPPConnect (jeśli działa), usunięcie bieżącej "
"instalacji oraz pobranie i zainstalowanie najnowszej wersji (v{version}), "
"bez sprawdzania, czy jest to już zainstalowana wersja. Kontynuować?"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1956
msgctxt "wpp_force_reinstall_confirm_title"
msgid "Force reinstall WPPConnect"
msgstr "Wymuś ponowną instalację WPPConnect"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/dialogs/settings_dialog.py:3663
#: client/ui/dialogs/settings_dialog.py:866
msgctxt "wpp_port_label"
msgid "API port (WPPConnect):"
msgstr "Port API (WPPConnect):"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/settings.py:266
msgctxt "wpp_reinstall_notice_message"
msgid ""
"Your current WPPConnect installation may be missing the latest features, "
"such as voice and video calls. Do you want to reinstall WPPConnect now? If "
"you change your mind, you can always access this option from the Help menu "
"(alt+h)."
msgstr ""
"Twoja obecna instalacja WPPConnect może nie mieć wszystkich najnowszych "
"funkcji, takich jak połączenia głosowe i wideo. Czy chcesz teraz ponownie "
"zainstalować WPPConnect? Jeśli zmienisz zdanie, zawsze możesz uzyskać dostęp"
" do tej opcji w menu pomocy (alt+c)."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/settings.py:270
msgctxt "wpp_reinstall_notice_title"
msgid "WPPConnect update recommended"
msgstr "Zalecana aktualizacja WPPConnect"

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1891
#, python-brace-format
msgctxt "wpp_update_available_msg"
msgid ""
"A recommended update for WPPConnect Server is available (current: {current},"
" new: {new}). It is not mandatory. Update now? WinZapp will stop the API, "
"install the new version, and restart it automatically."
msgstr ""
"Dostępna jest zalecana aktualizacja WPPConnect Server (obecna wersja: "
"{current}, nowa: {new}). Aktualizacja nie jest obowiązkowa. Zaktualizować "
"teraz? WinZapp zatrzyma API, zainstaluje nową wersję i automatycznie "
"uruchomi je ponownie."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1890
msgctxt "wpp_update_available_title"
msgid "WPPConnect update available"
msgstr "Dostępna aktualizacja WPPConnect"

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_background_update.py:157
#, python-brace-format
msgctxt "wpp_update_background_ready_msg"
msgid ""
"WPPConnect update {version} has been downloaded. WinZapp will go offline for"
" a moment to install it and restart WPPConnect."
msgstr ""
"Aktualizacja WPPConnect {version} została pobrana. WinZapp przejdzie na "
"chwilę w tryb offline, aby ją zainstalować i ponownie uruchomić WPPConnect."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:171
msgctxt "wpp_update_background_running"
msgid ""
"A WPPConnect update is already downloading in the background. You will be "
"told when it is ready to install."
msgstr ""
"Aktualizacja WPPConnect jest już pobierana w tle. Otrzymasz powiadomienie, "
"gdy będzie gotowa do instalacji."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_background_update.py:92
msgctxt "wpp_update_background_started"
msgid ""
"Downloading the WPPConnect update in the background. You will be told when "
"it is ready to install."
msgstr ""
"Pobieranie aktualizacji WPPConnect w tle. Otrzymasz powiadomienie, gdy "
"będzie gotowa do instalacji."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:316
msgctxt "wpp_update_complete"
msgid "WPPConnect updated and restarted successfully."
msgstr "WPPConnect zaktualizowany i uruchomiony ponownie pomyślnie."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:276
#: client/main_window/updates.py:279
#: client/main_window/wpp_background_update.py:137
msgctxt "wpp_update_failed_msg"
msgid ""
"Could not update WPPConnect. The previous installation will be kept, if "
"possible."
msgstr ""
"Nie udało się zaktualizować WPPConnect. Jeśli to możliwe, poprzednia "
"instalacja zostanie zachowana."

#: translations/en-US/LC_MESSAGES/winzapp.po client/updater.py:1943
msgctxt "wpp_update_fetch_failed_msg"
msgid ""
"Could not check the latest WPPConnect version. Check your internet "
"connection and try again."
msgstr ""
"Nie udało się sprawdzić najnowszej wersji WPPConnect. Sprawdź połączenie z "
"internetem i spróbuj ponownie."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:207
#: client/main_window/updates.py:291
msgctxt "wpp_update_in_progress"
msgid "Updating WPPConnect. Please wait."
msgstr "Aktualizowanie WPPConnect. Proszę czekać."

#: translations/en-US/LC_MESSAGES/winzapp.po client/main_window/updates.py:187
msgctxt "wpp_update_other_account_msg"
msgid ""
"Another WinZapp account is still using the WPPConnect Server. Close the "
"other accounts and try again."
msgstr ""
"Inne konto WinZapp nadal korzysta z WPPConnect Server. Zamknij pozostałe "
"konta i spróbuj ponownie."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/main_window/wpp_server.py:1252
msgctxt "wpp_version_unpinned_warning"
msgid ""
"Warning: could not pin the WhatsApp Web version. Sending to individual "
"contacts may fail silently; groups still work. Please update WinZapp's "
"WhatsApp Web."
msgstr ""
"Ostrzeżenie: nie udało się przypiąć wersji WhatsApp Web. Wysyłanie do "
"pojedynczych kontaktów może po cichu zawodzić; grupy nadal działają. "
"Zaktualizuj WhatsApp Web w WinZapp."

#: translations/en-US/LC_MESSAGES/winzapp.po
#: client/ui/conversation_panel/archived_panel.py:612
#: client/ui/conversation_panel/chat_list_selection.py:381
#: client/ui/conversation_panel/chat_menu.py:330
msgctxt "yes_button"
msgid "&Yes"
msgstr "&Tak"

